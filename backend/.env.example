# MySQL connection URL used by SQLAlchemy.
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ai_mock_interview
# Secret used to sign JWT access tokens.
SECRET_KEY=replace-with-a-long-random-secret
# JWT signing algorithm.
ALGORITHM=HS256
# JWT lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# API key for live interview interactions.
GEMINI_LIVE_API_KEY=replace-with-gemini-live-key
# API key for answer evaluation and reports.
GEMINI_EVALUATION_API_KEY=replace-with-gemini-evaluation-key
# Gemini model used for live interview interactions.
GEMINI_LIVE_MODEL=gemini-2.5-flash
# Gemini model used for answer evaluation.
GEMINI_EVALUATION_MODEL=gemini-2.5-flash
# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173
# Maximum expensive evaluation requests per client in the rate-limit window.
GEMINI_RATE_LIMIT=10
# Maximum code execution requests per client in the rate-limit window.
CODE_EXECUTION_RATE_LIMIT=10
# Rate-limit window length in seconds.
RATE_LIMIT_WINDOW_SECONDS=60
